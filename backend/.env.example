# Portfolio 3.0 Backend Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:4173

# Database (leave empty for SQLite local fallback)
DATABASE_URL=

# GitHub (optional - for background sync)
GITHUB_TOKEN=

# Spotify (optional - for creative metadata refresh)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Contact (optional - for email notifications)
CONTACT_PROVIDER=console
CONTACT_FROM=
CONTACT_TO=

# Trigger.dev (optional - for background automation)
TRIGGER_SECRET_KEY=
