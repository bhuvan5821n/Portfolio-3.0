# Public site origin used for canonical metadata.
NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example

# Portfolio API used by Server Components and the same-origin contact proxy.
# PORTFOLIO_API_URL stays server-only; NEXT_PUBLIC_PORTFOLIO_API_URL is the optional public equivalent.
PORTFOLIO_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_PORTFOLIO_API_URL=http://127.0.0.1:3001

# ── Vercel Services deployment ──────────────────────────────────────
# PORTFOLIO_API_URL is auto-injected by the service binding in vercel.json.
# Do NOT set it manually in Vercel project settings for production.
# NEXT_PUBLIC_PORTFOLIO_API_URL is NOT needed — the frontend calls /api/v1/* as same-origin rewrites.
#
# DATABASE_URL: Set to a PostgreSQL connection string for durable contact persistence.
#               Without it, the backend uses in-memory SQLite (data resets on cold start).
#               Contact submissions are lost on cold start without PostgreSQL.
